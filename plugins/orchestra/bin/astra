#!/usr/bin/env bash
# Run a task through Codex CLI on GPT-6-Astra and print Codex's final message.
#
# Usage: astra [--read-only] "<prompt>"
#        echo "<prompt>" | astra [--read-only]
#
# Env:
#   CODEX_ASTRA_MODEL   model slug (default: gpt-6-astra)
#   CODEX_ASTRA_EFFORT  reasoning effort: low|medium|high|xhigh (default: high)
#   CODEX_ASTRA_SANDBOX sandbox override: read-only|workspace-write|danger-full-access
#   OPENAI_API_KEY      used to log Codex in when no ~/.codex/auth.json exists
set -euo pipefail

model="${CODEX_ASTRA_MODEL:-gpt-6-astra}"
effort="${CODEX_ASTRA_EFFORT:-high}"
sandbox="${CODEX_ASTRA_SANDBOX:-workspace-write}"

if [[ "${1:-}" == "--read-only" ]]; then
  sandbox="read-only"
  shift
fi

prompt="${1:-}"
if [[ -z "$prompt" && ! -t 0 ]]; then
  prompt="$(cat)"
fi
if [[ -z "$prompt" ]]; then
  echo "astra: no prompt given" >&2
  exit 2
fi

if command -v codex >/dev/null 2>&1; then
  codex=(codex)
else
  codex=(npx -y @openai/codex@latest)
fi

codex_home="${CODEX_HOME:-$HOME/.codex}"
if [[ ! -f "$codex_home/auth.json" ]]; then
  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    printenv OPENAI_API_KEY | "${codex[@]}" login --with-api-key >/dev/null
  else
    echo "astra: Codex is not logged in. Run 'codex login' locally, or set OPENAI_API_KEY in the environment." >&2
    exit 3
  fi
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
out="$(mktemp -t astra-last.XXXXXX)"
trap 'rm -f "$out"' EXIT

printf '%s' "$prompt" | "${codex[@]}" exec \
  --model "$model" \
  -c "model_reasoning_effort=\"$effort\"" \
  -c 'approval_policy="never"' \
  --sandbox "$sandbox" \
  --cd "$repo_root" \
  --ephemeral \
  --color never \
  --output-last-message "$out" \
  - >&2

cat "$out"
